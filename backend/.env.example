# MongoDB (required)
MONGO_URI=mongodb://127.0.0.1:27017/LocalGigFinder

# JWT (required)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Server
PORT=5011
BIND_HOST=127.0.0.1
NODE_ENV=development

# Frontend URL for CORS & Socket.io
CLIENT_URL=http://localhost:5173

# Serve built frontend from Express (set true in production single-server deploy)
SERVE_FRONTEND=false

# SMTP Email (optional — password reset OTP emails)
# Works with any provider: Gmail, Outlook, SendGrid, Mailgun, custom SMTP
# For Gmail: use an App Password (Google Account → Security → App Passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Admin seed script (run: npm run seed:admin --prefix backend)
ADMIN_EMAIL=admin@localgigfinder.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Platform Admin
